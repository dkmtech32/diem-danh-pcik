   "text": [
    "📖 ",
    {
     "type": "bold",
     "text": "How to use"
    },
    "\n\n",
    {
     "type": "bold",
     "text": "Create a session:"
    },
    "\n",
    {
     "type": "code",
     "text": "/session Title | Date/Time | Location | EstimatedCost"
    },
    "\nExample: ",
    {
     "type": "code",
     "text": "/session Friday Pickleball | 7:00 PM | Court A | 120000"
    },
    "\n\n",
    {
     "type": "bold",
     "text": "Workflow:"
    },
    "\n1️⃣ Admin creates session with ",
    {
     "type": "bot_command",
     "text": "/session"
    },
    "\n2️⃣ Members tap Join / Maybe / Skip\n3️⃣ Admin taps Finalize Attendance\n4️⃣ Admin taps Split Bill and enters total cost\n5️⃣ Members tap Mark Paid\n6️⃣ Admin taps Close Session\n\n",
    {
     "type": "bold",
     "text": "View recent sessions:"
    },
    "\n",
    {
     "type": "bot_command",
     "text": "/sessions"
    },
    ""
